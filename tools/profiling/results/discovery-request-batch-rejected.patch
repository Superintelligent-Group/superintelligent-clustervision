+    #[test]
+    fn requested_batch_only_loads_matching_tuples_and_negative_results_are_final() {
+        let world = cv_testkit::World::in_process("scan-demand-batch");
+        let paths: Vec<_> = (0..5).map(|i| world.base.join(format!("source-{i}"))).collect();
+        for path in &paths[..4] {
+            std::fs::write(path, "metadata").unwrap();
+        }
+        let conn = crate::catalog::open_at(&world.base.join("catalog.db")).unwrap();
+        for (i, path) in paths[..4].iter().enumerate() {
+            row(&conn, path, &format!("stored-{i}"));
+        }
+        conn.execute(
+            "UPDATE scan_cache SET refs='malformed' WHERE path=?1",
+            [paths[1].to_string_lossy()],
+        )
+        .unwrap();
+        conn.execute("DELETE FROM scan_cache WHERE path=?1", [paths[2].to_string_lossy()])
+            .unwrap();
+        conn.execute(
+            "UPDATE scan_cache SET size=size+1 WHERE path=?1",
+            [paths[3].to_string_lossy()],
+        )
+        .unwrap();
+        let unrelated = world.base.join("unrelated");
+        std::fs::write(&unrelated, "metadata").unwrap();
+        row(&conn, &unrelated, "unrelated");
+        let context = Context::from_connection(Arc::new(std::sync::Mutex::new(conn)));
+        let scans = std::sync::atomic::AtomicUsize::new(0);
+        let refs = context.run(|| {
+            super::super::cached_scan_batch(paths.clone(), |_| {
+                scans.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                Vec::new()
+            })
+        });
+        assert_eq!(refs.len(), 1);
+        assert_eq!(refs[0].id, "stored-0");
+        assert_eq!(scans.load(std::sync::atomic::Ordering::Relaxed), 4);
+        assert_eq!(
+            context.work(),
+            (0, 1, 2),
+            "one SQL batch, including malformed demanded row, without duplicate negative lookups"
+        );
+        assert!(!context.cache().entries.read().unwrap().contains_key(&unrelated));
+    }
+
