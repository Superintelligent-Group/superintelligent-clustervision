    "inventory": "20,000 / 100,000 synthetic refs to one tiny existing file; message-count sort; window=20",
    "shapes": {
      "shuffled": "(ordinal * 2654435761) % 10007, with ties",
      "sorted": "count - ordinal",
      "reverse": "ordinal",
      "tied": "7"
    },
    "comparison_baseline": "Prior stable sort_by_key over owned SessionRef values; key calls / 2 count comparator invocations.",
    "heap_baseline": "Prior select_refs plus json_rows, including actual full-sort scratch; inventory creation/cloning excluded.",
    "output_oracle": "Exact selected serde_json rows; separate presence/tie test covers all three keys, both directions, missing files, 0/1/3/20/full/unlimited limits."
  },
