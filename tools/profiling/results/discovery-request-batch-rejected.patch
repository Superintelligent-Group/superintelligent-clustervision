+/// Scan already-enumerated demands in bounded chunks. Only matching requested tuples are read;
+/// decoded entries never retain the SQL connection, and current process entries always win.
+pub(crate) fn cached_scan_batch<F>(paths: Vec<PathBuf>, scan: F) -> Vec<SessionRef>
+where
+    F: Fn(&Path) -> Vec<SessionRef> + Sync + Send,
+{
+    if paths.len() <= 1 {
+        return paths
+            .into_iter()
+            .flat_map(|path| cached_scan_many(&path, || scan(&path)))
+            .collect();
+    }
+    let context = read::Context::current();
+    let cache = context.cache();
+    clear_invalidated(&cache);
+    let mut paths = paths.into_iter();
+    let mut result = Vec::new();
+    loop {
+        // 128 bounds transient encoded payloads and SQLite parameters, not a crossover claim.
+        let chunk: Vec<_> = paths
+            .by_ref()
+            .take(128)
+            .map(|path| {
+                let mut reads = crate::source::ReadSet::default();
+                reads.record(&path);
+                let key = stat_key(&path);
+                (path, reads, key)
+            })
+            .collect();
+        if chunk.is_empty() {
+            break;
+        }
+        #[cfg(feature = "sqlite")]
+        let checked = {
+            let demands: Vec<_> = {
+                let entries = cache.entries.read().unwrap();
+                chunk
+                    .iter()
+                    .enumerate()
+                    .filter_map(|(index, (path, _, key))| {
+                        (!entries.contains_key(path))
+                            .then_some(key.map(|key| (index, path, key)))
+                            .flatten()
+                    })
+                    .collect()
+            };
+            let loaded = if demands.is_empty() {
+                Some(Vec::new())
+            } else {
+                #[cfg(test)]
+                context.note_lookup();
+                context
+                    .with_connection(|connection| load_batch(connection, &demands))
+                    .flatten()
+            };
+            clear_invalidated(&cache);
+            if let Some(loaded) = loaded {
+                for (index, entry) in loaded {
+                    #[cfg(test)]
+                    context.note_row();
+                    let (path, reads, _) = &chunk[index];
+                    admit_batch(&cache, path, entry, reads);
+                }
+                true // A successful negative query is already checked, including malformed rows.
+            } else {
+                false
+            } // Tolerant SQL failure preserves individual keyed fallback.
+        };
+        #[cfg(not(feature = "sqlite"))]
+        let checked = false;
+        result.extend(crate::par_flat_map(chunk, |(path, reads, key)| {
+            context.run(|| scan_captured(&path, reads, key, || scan(&path), &context, &cache, checked))
+        }));
+    }
+    result
+}
+
+#[cfg(feature = "sqlite")]
+fn admit_batch(cache: &Cache, path: &Path, mut entry: Entry, reads: &crate::source::ReadSet) {
+    entry.payload.parsed(); // Decode after releasing SQL lock.
+    if entry.payload.known().is_some_and(|(_, captured)| captured == reads) {
+        cache
+            .entries
+            .write()
+            .unwrap()
+            .entry(path.to_path_buf())
+            .or_insert(entry);
+    }
+}
+
+#[cfg(feature = "sqlite")]
+fn load_batch(conn: &rusqlite::Connection, demands: &[(usize, &PathBuf, (u64, u64))]) -> Option<Vec<(usize, Entry)>> {
+    use rusqlite::types::Value;
+    let mut sql = String::from("WITH requested(path,mtime_ns,size,slot) AS (VALUES ");
+    let mut parameters = Vec::with_capacity(demands.len() * 3 + 1);
+    for (i, (slot, path, key)) in demands.iter().enumerate() {
+        if i != 0 {
+            sql.push(',');
+        }
+        sql.push_str(&format!("(?,?,?,{slot})"));
+        parameters.extend([
+            Value::Text(path.to_string_lossy().into_owned()),
+            Value::Integer(key.0 as i64),
+            Value::Integer(key.1 as i64),
+        ]);
+    }
+    sql.push_str(") SELECT requested.slot,scan_cache.mtime_ns,scan_cache.size,refs,source_reads FROM requested JOIN scan_cache ON scan_cache.path=requested.path AND scan_cache.mtime_ns=requested.mtime_ns AND scan_cache.size=requested.size WHERE interpretation_version=?");
+    parameters.push(Value::Integer(INTERPRETATION_VERSION as i64));
+    let mut statement = conn.prepare_cached(&sql).ok()?;
+    let result = statement
+        .query_map(rusqlite::params_from_iter(parameters), |row| {
+            Ok((
+                row.get::<_, usize>(0)?,
+                Entry {
+                    mtime_ns: row.get::<_, i64>(1)? as u64,
+                    size: row.get::<_, i64>(2)? as u64,
+                    payload: Payload::Encoded {
+                        refs: row.get(3)?,
+                        reads: row.get(4)?,
+                    },
+                    dirty: false,
+                },
+            ))
+        })
+        .ok()?
+        .collect::<Result<Vec<_>, _>>()
+        .ok();
+    result
+}
