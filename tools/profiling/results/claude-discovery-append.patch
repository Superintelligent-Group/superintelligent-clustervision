@@ -0,0 +1,19 @@
+//! Diagnostic evidence patch: dump live stored documents for exact controlled parity.
+use anyhow::{Context, Result};
+use tantivy::{schema::document::Document, Index, TantivyDocument};
+fn main() -> Result<()> {
+    let path = std::env::args().nth(1).context("index path")?;
+    let index = Index::open_in_dir(path)?;
+    let searcher = index.reader()?.searcher();
+    let mut docs = Vec::new();
+    for segment in searcher.segment_readers() {
+        let store = segment.get_store_reader(0)?;
+        for id in segment.doc_ids_alive() {
+            let doc: TantivyDocument = store.get(id)?;
+            docs.push(doc.to_json(&index.schema()));
+        }
+    }
+    docs.sort();
+    serde_json::to_writer(std::io::stdout(), &docs)?;
+    Ok(())
+}
