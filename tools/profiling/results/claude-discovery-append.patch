+#[cfg(feature = "probe-heap")]
+struct IndexWorkFile(std::fs::File);
+#[cfg(feature = "probe-heap")]
+impl std::ops::Deref for IndexWorkFile {
+    type Target = std::fs::File;
+    fn deref(&self) -> &Self::Target { &self.0 }
+}
+#[cfg(feature = "probe-heap")]
+impl std::io::Read for IndexWorkFile {
+    fn read(&mut self, output: &mut [u8]) -> std::io::Result<usize> {
+        let n = std::io::Read::read(&mut self.0, output)?;
+        crate::harness::claude::probe_index_work("resume_guard_file_read_returned", None, n as u64);
+        Ok(n)
+    }
+}
+#[cfg(feature = "probe-heap")]
+impl std::io::Seek for IndexWorkFile {
+    fn seek(&mut self, pos: std::io::SeekFrom) -> std::io::Result<u64> {
+        std::io::Seek::seek(&mut self.0, pos)
+    }
+}
